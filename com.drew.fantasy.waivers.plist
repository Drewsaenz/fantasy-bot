<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.drew.fantasy.waivers</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/drews/Desktop/Home/fantasy-bot/.venv/bin/python</string>
        <string>/Users/drews/Desktop/Home/fantasy-bot/fantasy_check.py</string>
        <string>--mode</string>
        <string>waivers</string>
        <string>--notify</string>
        <string>--telegram</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/drews/Desktop/Home/fantasy-bot</string>

    <!-- Tuesday 8:00 PM local: waiver targets and trade ideas before waivers process overnight. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/drews/Desktop/Home/fantasy-bot/waivers.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/drews/Desktop/Home/fantasy-bot/waivers.log</string>
</dict>
</plist>
