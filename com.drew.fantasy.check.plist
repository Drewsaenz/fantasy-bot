<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.drew.fantasy.check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/drews/Desktop/Home/fantasy-bot/.venv/bin/python</string>
        <string>/Users/drews/Desktop/Home/fantasy-bot/fantasy_check.py</string>
        <string>--mode</string>
        <string>check</string>
        <string>--notify</string>
        <string>--telegram</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/drews/Desktop/Home/fantasy-bot</string>

    <!-- Local time. Weekday: 0 = Sunday ... 6 = Saturday. A run missed while asleep fires on wake.
         Wed 8:00 AM after waivers, Thu 4:00 PM before TNF, Sun 10:00 AM injury check,
         Sun 11:30 AM last inactives before the noon games, Sun 6:30 PM late swap before SNF. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/drews/Desktop/Home/fantasy-bot/check.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/drews/Desktop/Home/fantasy-bot/check.log</string>
</dict>
</plist>
